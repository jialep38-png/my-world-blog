---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { planets } from '../../data/planets';
import { createWithBase } from '../../utils/format';
const withBase = createWithBase(import.meta.env.BASE_URL ?? '/');
---

<BaseLayout title="小星球" description="五颗小星球，收好歌曲、记忆与日常的形状。霁风的小圈里的一个小小展廊。" bodyClass="planets-page">
  <header class="planet-page-heading">
    <p class="planet-eyebrow">MY LITTLE ORBIT <span aria-hidden="true">/</span> 01—05</p>
    <h1>小星球</h1>
    <p class="planet-handwriting">给文字之外的心情，留一点位置。</p>
    <p class="planet-introduction">有些感受，写成了随笔；有些，成了小小的星球。<br class="planet-desktop-break" />薄膜、相纸、册页、雨幕与青绿，各自留下一种形状。</p>
  </header>

  <div class="planet-index">
    {planets.map((planet) => (
      <article class:list={['planet-index__entry', `planet-tone--${planet.tone}`]}>
        <a class="planet-index__art" href={withBase(`/planets/${planet.id}/`)} aria-label={`走近《${planet.title}》`}>
          <span class="planet-index__number" aria-hidden="true">{planet.number}</span>
          <Image src={planet.cover} alt={`${planet.title}：${planet.materials}`} width={700} widths={[320, 480, 700]} sizes="(max-width: 560px) calc(100vw - 60px), (max-width: 900px) 42vw, 320px" loading={planet.number === '01' ? 'eager' : 'lazy'} format="webp" />
          <span class="planet-index__open" aria-hidden="true">走近一点 ↗</span>
        </a>
        <div class="planet-index__caption">
          <p class="planet-eyebrow">{planet.english}</p>
          <h2><a href={withBase(`/planets/${planet.id}/`)}>{planet.title}</a></h2>
          <p>{planet.thought}</p>
        </div>
      </article>
    ))}
    <aside class="planet-index__aside">
      <svg class="planet-orbit-drawing" viewBox="0 0 120 100" fill="none" aria-hidden="true"><ellipse cx="60" cy="50" rx="49" ry="19" transform="rotate(-28 60 50)"/><circle cx="60" cy="50" r="30"/><circle cx="20" cy="65" r="3"/></svg>
      <p>音乐经过以后，<br />记忆有了容器。</p>
      <small>慢慢看，不必一次逛完。</small>
      <a href={withBase('/essay/')}>回到文字里 <span aria-hidden="true">↗</span></a>
    </aside>
  </div>
  <p class="planet-colophon">留下的形状 · 五件概念作品<br />图版来自各自的三维场景，进入作品后可以转动观看。</p>
</BaseLayout>
