---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroImage from '../components/HeroImage.astro';
import EntryListItem from '../components/EntryListItem.astro';
import PlanetShelf from '../components/PlanetShelf.astro';
import { getPublished, getSortedProjects, getProjectSlug, isReservedSlug } from '../lib/content';
import { getListExcerpt } from '../utils/excerpt';
import { createWithBase } from '../utils/format';

const base = import.meta.env.BASE_URL ?? '/';
const withBase = createWithBase(base);

const essays = await getPublished('essay', {
  orderBy: (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
});
const projects = await getSortedProjects();

const visibleEssays = essays.filter((entry) =>
  !isReservedSlug(entry.data.slug ?? entry.id) && !entry.data.project
);

const latest = [
  ...visibleEssays.map((entry) => ({
    href: withBase(`/archive/${entry.data.slug ?? entry.id}/`),
    title: entry.data.title,
    date: entry.data.date,
    tag: entry.data.tags?.[0] ?? '随笔',
    excerpt: getListExcerpt(entry),
    isProject: false
  })),
  ...projects.map((entry) => ({
    href: withBase(`/projects/${getProjectSlug(entry)}/`),
    title: entry.data.title,
    date: entry.data.date,
    tag: entry.data.tags?.[0] ?? '项目',
    excerpt: entry.data.description,
    isProject: true
  }))
]
  .sort((a, b) => {
    const dateDiff = b.date.valueOf() - a.date.valueOf();
    if (dateDiff !== 0) return dateDiff;
    // 同一日期时，项目优先
    return (b.isProject ? 1 : 0) - (a.isProject ? 1 : 0);
  })
  .slice(0, 12);
const collections = [
  { href: '/essay/', title: '随笔', subtitle: '一点想法，一些日常', number: String(visibleEssays.length).padStart(2, '0'), kind: 'writing' },
  { href: '/projects/', title: '项目', subtitle: '把想法做成可用的东西', number: String(projects.length).padStart(2, '0'), kind: 'making' },
  { href: '/planets/', title: '小星球', subtitle: '给文字之外的心情', number: '05', kind: 'orbit' },
];
---

<BaseLayout bodyClass="home">
  <header class="home-heading">
    <div><p class="eyebrow">MY WORLD · 个人手记</p><h1>霁风的小圈<span aria-hidden="true">。</span></h1></div>
    <a class="home-about" href={withBase('/about/')}>很高兴遇见你 <span aria-hidden="true">↗</span></a>
  </header>
  <div class="hero">
    <HeroImage isLCP />
  </div>

  <div class="intro intro--serif">
    <span class="intro__lead">欢迎来到我的小圈，这里会发一些随缘做的项目和一点点感想。</span>
    <span class="intro__more">更多内容请访问 <a href={withBase('/archive/')}>归档</a> 或 <a href={withBase('/projects/')}>项目</a>。</span>
  </div>

  <PlanetShelf />

  <section class="home-latest" aria-labelledby="latest-title" data-home-latest>
  <div class="home-section-heading">
    <div><p class="eyebrow">RECENTLY</p><h2 id="latest-title">最近更新</h2></div>
    <div class="home-filters" role="group" aria-label="筛选最近更新" hidden>
      <span class="home-filters__indicator" aria-hidden="true"></span>
      <button type="button" data-filter="all" aria-pressed="true">全部</button>
      <button type="button" data-filter="essay" aria-pressed="false">随笔</button>
      <button type="button" data-filter="project" aria-pressed="false">项目</button>
    </div>
  </div>
  <p class="sr-only" role="status" data-filter-status></p>

  <div class="list home-entries">
    {latest.map((entry) => (
      <EntryListItem
        href={entry.href}
        title={entry.title}
        date={entry.date}
        tag={entry.tag}
        excerpt={entry.excerpt}
        kind={entry.isProject ? 'project' : 'essay'}
      />
    ))}
  </div>
  <a class="home-all-link" href={withBase('/archive/')}>翻翻全部内容 <span aria-hidden="true">↗</span></a>
  </section>

  <section class="home-collections" aria-labelledby="collections-title">
    <div class="home-section-heading"><div><p class="eyebrow">EXPLORE</p><h2 id="collections-title">随处逛逛</h2></div><span class="home-section-note">每一页，都是小圈的一部分</span></div>
    <div class="collection-grid">
      {collections.map((item) => <a class={`collection-card collection-card--${item.kind}`} href={withBase(item.href)}>
        <span class="collection-card__tab" aria-hidden="true"></span><span class="collection-card__number">{item.number}<small>{item.kind === 'orbit' ? '颗星球' : '篇记录'}</small></span>
        <strong>{item.title}<span aria-hidden="true">↗</span></strong><span class="collection-card__note">{item.subtitle}</span>
      </a>)}
    </div>
  </section>
  <script>import '../scripts/home.ts';</script>
</BaseLayout>
