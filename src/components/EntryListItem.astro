---
import { formatISODate } from '../utils/format';

const {
  href,
  title,
  excerpt,
  date,
  tag,
  kind
} = Astro.props;
---

<a class="list-item list-item--link" href={href} data-entry-kind={kind}>
  {kind && <span class="list-item__kind">{kind === 'project' ? '项目' : '随笔'}<span aria-hidden="true">↗</span></span>}
  <div class="list-item__row">
    <h3 class="list-item__title">{title}</h3>
  </div>
  {excerpt ? <p class="list-item__excerpt">{excerpt}</p> : null}
  <div class="meta-line">
    <time datetime={formatISODate(date)}>{formatISODate(date)}</time>
    {tag ? <> · <span class="tag">#{tag}</span></> : null}
  </div>
</a>
