---
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Lightbox from '../components/Lightbox.astro';
import ArticleToc from '../components/ArticleToc.astro';
import { createWithBase, formatISODate } from '../utils/format';
import { getMetaDescription } from '../utils/excerpt';

const {
  entry,
  Content,
  headings = [],
  typeLabel,
  prev,
  next
} = Astro.props;

const tags = entry?.data?.tags ?? [];
const hasToc = headings.some((item: { depth: number }) => item.depth === 2 || item.depth === 3);
const firstTag = tags[0];
const defaultImage = '/og.svg';
const coverImage = entry?.data?.cover ?? null;
const ogImage = coverImage ?? defaultImage;
const description = getMetaDescription(entry);
const withBase = createWithBase(import.meta.env.BASE_URL ?? '/');
const archiveHref = withBase('archive/');

const estimateReadingMinutes = (source: string) => {
  const readable = source
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/`[^`]*`/g, ' ')
    .replace(/<[^>]+>/g, ' ')
    .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .replace(/[#>*_~|=-]+/g, ' ');
  const hanCount = readable.match(/[\u3400-\u4dbf\u4e00-\u9fff\uf900-\ufaff]/g)?.length ?? 0;
  const wordCount = readable.match(/[a-z0-9]+(?:['’-][a-z0-9]+)*/gi)?.length ?? 0;
  return Math.max(1, Math.ceil((hanCount / 350) + (wordCount / 200)));
};

const readingMinutes = estimateReadingMinutes(entry?.body ?? '');

---

<BaseLayout
  title={entry.data.title}
  description={description}
  image={ogImage}
  ogType="article"
  bodyClass="article-page immersive-page"
>
  <Fragment slot="head">
    <meta property="article:published_time" content={entry.data.date.toISOString()} />
    {tags.map((tag: string) => (
      <meta property="article:tag" content={tag} />
    ))}
  </Fragment>
  <div
    class="article-progress"
    data-article-progress
    role="progressbar"
    aria-label="文章阅读进度"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
  >
    <span class="article-progress__bar" aria-hidden="true"></span>
  </div>
  <div class="article-header reader-exit-anchor">
    <div class="article-header__tools">
      <a class="article-back" href={archiveHref} aria-label="返回文章列表">
        <span aria-hidden="true">←</span>
        <span>返回文章</span>
      </a>
      <div class="article-utilities">
        <span class="article-reading-time">约 {readingMinutes} 分钟</span>
        <button class="article-share" type="button" data-copy-article-link data-state="idle">
          <span data-copy-article-label>复制链接</span>
        </button>
        <span class="sr-only" data-copy-article-status aria-live="polite"></span>
      </div>
    </div>
    <h1 class="page-title">{entry.data.title}</h1>
    <button
      id="reader-exit"
      class="icon-button reader-exit"
      type="button"
      aria-label="退出阅读"
      title="退出阅读"
      aria-hidden="true"
      tabindex="-1"
    >
      <Icon name="reader-exit" class="icon" />
    </button>
    <div class="meta-line">
      发布于：{formatISODate(entry.data.date)}
      {typeLabel ? <> · <span class="tag">{typeLabel}</span></> : null}
      {firstTag ? <> · <span class="tag">#{firstTag}</span></> : null}
    </div>
  </div>

  <div class:list={["article-with-toc", hasToc && "article-with-toc--active"]}>
    <ArticleToc headings={headings} />
    <div class="article-main">
      <div class="prose" data-article-body>
        <Content />
      </div>
      {(prev || next) ? (
        <nav class="prev-next" aria-label="上一篇/下一篇">
          <div class="prev-next__item">
            {prev ? (
              <a class="prev-next__link prev-next__link--prev" href={prev.href} rel="prev">
                <span class="prev-next__label">上一篇</span>
                <span class="prev-next__title">{prev.title}</span>
              </a>
            ) : (
              <span class="prev-next__placeholder" aria-hidden="true"></span>
            )}
          </div>
          <div class="prev-next__item">
            {next ? (
              <a class="prev-next__link prev-next__link--next" href={next.href} rel="next">
                <span class="prev-next__label">下一篇</span>
                <span class="prev-next__title">{next.title}</span>
              </a>
            ) : (
              <span class="prev-next__placeholder" aria-hidden="true"></span>
            )}
          </div>
        </nav>
      ) : null}

      <section class="comments">
        <h2 class="comments__title">留言</h2>
        <script
          src="https://giscus.app/client.js"
          data-repo="jialep38-png/my-world-blog"
          data-repo-id="R_kgDORa5XZA"
          data-category="Announcements"
          data-category-id="DIC_kwDORa5XZM4C3Yvw"
          data-mapping="pathname"
          data-strict="0"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="bottom"
          data-theme="preferred_color_scheme"
          data-lang="zh-CN"
          crossorigin="anonymous"
          async
        ></script>
      </section>
    </div>
  </div>

  <Lightbox
    id="lightbox"
    label="图片预览"
    enableZoom={false}
    enablePan={false}
    enableSwipeDownClose={false}
  />

  <script>
    import { initArticleLightbox } from '../scripts/lightbox';
    import { initArticleReading } from '../scripts/article-reading';

    initArticleLightbox({
      dialogId: 'lightbox',
      containerSelector: '.prose',
      enableZoom: false,
      enablePan: false,
      enableSwipeDownClose: false
    });
    initArticleReading();
  </script>
</BaseLayout>
